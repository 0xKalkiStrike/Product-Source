# =======================================================================
# SUPABASE & PRODUCTION ENVIRONMENT CONFIGURATION
# =======================================================================

# 1. Supabase Database Connection URL
# Replace with your Supabase PostgreSQL connection string from Supabase Settings -> Database
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# 2. Supabase API Credentials
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 3. Application Security Secret Key
SECRET_KEY=YOUR_SUPER_SECRET_PRODUCTION_KEY_9876543210
